:root {
    --navy: #1f3a68;
    --navy-dark: #162b4f;
    --light-gray: #f4f6f9;
    --sidebar-width: 260px;

    --bs-primary: #1f3a68;
    --bs-primary-rgb: 31, 58, 104;
    --bs-link-color-rgb: 31, 58, 104;
    --bs-link-hover-color-rgb: 22, 43, 79;
}

body { background-color: var(--light-gray); color: #212529; }

.btn-primary {
    --bs-btn-bg: var(--navy);
    --bs-btn-border-color: var(--navy);
    --bs-btn-hover-bg: var(--navy-dark);
    --bs-btn-hover-border-color: var(--navy-dark);
    --bs-btn-active-bg: var(--navy-dark);
    --bs-btn-active-border-color: var(--navy-dark);
    --bs-btn-disabled-bg: var(--navy);
    --bs-btn-disabled-border-color: var(--navy);
}

.card { --bs-card-border-color: #e3e7ee; box-shadow: 0 1px 3px rgba(16, 24, 40, 0.06); }

.sidebar { --bs-offcanvas-width: var(--sidebar-width); background-color: var(--navy); color: #fff; }

.sidebar .offcanvas-body {
    display: flex; flex-direction: column; flex-grow: 1; padding: 1rem; overflow-y: auto;
}

.sidebar-brand {
    font-size: 1.1rem; font-weight: 600; color: #fff; align-items: center; padding: 0.25rem 0.5rem 1rem;
}

.sidebar .nav-link {
    display: flex; align-items: center; gap: 0.65rem; padding: 0.6rem 0.85rem;
    border-radius: 0.5rem; color: rgba(255, 255, 255, 0.85);
}
.sidebar .nav-link:hover { background-color: rgba(255, 255, 255, 0.12); color: #fff; }
.sidebar .nav-link.active { background-color: #fff; color: var(--navy); font-weight: 600; }
.sidebar .nav-link.disabled { color: rgba(255, 255, 255, 0.55); }

.sidebar .stage-badge {
    margin-left: auto; font-size: 0.65rem; background: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.8); padding: 0.1rem 0.4rem; border-radius: 0.75rem;
}

.sidebar-user { border-top: 1px solid rgba(255, 255, 255, 0.2); padding-top: 1rem; margin-top: 1rem; }

.mobile-topbar {
    background-color: var(--navy); color: #fff; display: flex; align-items: center;
    gap: 0.75rem; padding: 0.6rem 1rem; position: sticky; top: 0; z-index: 1020;
}

@media (min-width: 992px) {
    .sidebar.offcanvas-lg {
        position: fixed; top: 0; bottom: 0; left: 0; z-index: 1030;
        width: var(--sidebar-width) !important; height: 100vh !important;
        background-color: var(--navy) !important;
    }
    .main-content { margin-left: var(--sidebar-width); }
}

.stat-icon {
    width: 3rem; height: 3rem; border-radius: 0.75rem; display: flex;
    align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0;
}
.stat-value { font-size: 1.75rem; font-weight: 700; line-height: 1.1; }
.chart-box { position: relative; height: 280px; }
.empty-state { text-align: center; padding: 2rem 1rem; color: #6c757d; }
.empty-state .bi { font-size: 2rem; display: block; margin-bottom: 0.5rem; }

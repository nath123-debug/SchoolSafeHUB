@model CreateUserViewModel
@{
    ViewData["Title"] = "Add user";
}

<div class="mb-4">
    <a asp-action="Index" class="small text-decoration-none">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to user management
    </a>
    <h1 class="h3 mb-0 mt-1">Add user</h1>
    <p class="text-muted mb-0">Create a staff, administrator, or student account with a temporary password.</p>
</div>

<div class="row">
    <div class="col-12 col-xl-7">
        <div class="card">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" maxlength="100" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="SchoolIdNumber" class="form-label"></label>
                            <input asp-for="SchoolIdNumber" class="form-control" maxlength="30" />
                            <span asp-validation-for="SchoolIdNumber" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" class="form-select">
                                @foreach (var r in AppRoles.All)
                                {
                                    <option value="@r" selected="@(Model.Role == r)">@r</option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter, and a number.</div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Create account</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

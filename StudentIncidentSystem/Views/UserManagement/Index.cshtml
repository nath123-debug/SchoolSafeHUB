@model UserIndexViewModel
@{
    ViewData["Title"] = "User management";
    var filtersActive = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrEmpty(Model.Role) || !string.IsNullOrEmpty(Model.Status);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">User management</h1>
        <p class="text-muted mb-0">Create accounts, change roles, and activate or deactivate users.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Add user
    </a>
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="q" class="form-label small mb-1">Search name, email, or school ID</label>
                <input id="q" name="q" value="@Model.Search" class="form-control" maxlength="100" />
            </div>
            <div class="col-6 col-md-3">
                <label for="role" class="form-label small mb-1">Role</label>
                <select id="role" name="role" class="form-select">
                    <option value="">All roles</option>
                    @foreach (var r in AppRoles.All)
                    {
                        <option value="@r" selected="@(Model.Role == r)">@r</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="status" class="form-label small mb-1">Account status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All</option>
                    <option value="active" selected="@(Model.Status == "active")">Active</option>
                    <option value="inactive" selected="@(Model.Status == "inactive")">Deactivated</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (filtersActive)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Users.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users.Items)
                    {
                        <tr>
                            <td>
                                @u.FullName
                                @if (u.Id == Model.CurrentUserId)
                                {
                                    <span class="badge text-bg-light border ms-1">You</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(u.SchoolIdNumber))
                                {
                                    <div class="small text-muted">@u.SchoolIdNumber</div>
                                }
                            </td>
                            <td>@u.Email</td>
                            <td>
                                <span class="badge @(u.Role == AppRoles.Administrator ? "text-bg-dark" : u.Role == AppRoles.Staff ? "text-bg-primary" : "text-bg-secondary")">@(u.Role ?? "None")</span>
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Deactivated</span>
                                }
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge text-bg-warning">Locked out</span>
                                }
                            </td>
                            <td class="text-nowrap small"><partial name="_LocalTime" model="u.CreatedAtUtc" /></td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm">
                                    Manage<span class="visually-hidden"> @u.FullName</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted">
                @Model.Users.TotalCount user@(Model.Users.TotalCount == 1 ? "" : "s") &middot; page @Model.Users.Page of @Model.Users.TotalPages
            </span>
            <partial name="_UserPager" model="new UserPagerInfo(Model.Users.Page, Model.Users.TotalPages, Model.Search, Model.Role, Model.Status)" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-people" aria-hidden="true"></i>
            No users match your filters.
        </div>
    }
</div>

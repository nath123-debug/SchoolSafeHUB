@model AuditLogIndexViewModel
@{
    ViewData["Title"] = "Audit logs";
    var filtersActive = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrEmpty(Model.Outcome)
                        || Model.From.HasValue || Model.To.HasValue;

    var query = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Search)) query["q"] = Model.Search.Trim();
    if (!string.IsNullOrEmpty(Model.Outcome)) query["outcome"] = Model.Outcome;
    if (Model.From.HasValue) query["from"] = Model.From.Value.ToString("yyyy-MM-dd");
    if (Model.To.HasValue) query["to"] = Model.To.Value.ToString("yyyy-MM-dd");
}

<div class="mb-4">
    <h1 class="h3 mb-0">Audit logs</h1>
    <p class="text-muted mb-0">Who did what, and when. Passwords and note contents are never recorded.</p>
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="q" class="form-label small mb-1">Search user, action, or details</label>
                <input id="q" name="q" value="@Model.Search" class="form-control" maxlength="100" />
            </div>
            <div class="col-6 col-md-2">
                <label for="outcome" class="form-label small mb-1">Outcome</label>
                <select id="outcome" name="outcome" class="form-select">
                    <option value="">All</option>
                    @foreach (var o in AuditService.Outcomes)
                    {
                        <option value="@o" selected="@(Model.Outcome == o)">@o</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="from" class="form-label small mb-1">From</label>
                <input id="from" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label for="to" class="form-label small mb-1">To</label>
                <input id="to" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (filtersActive)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Logs.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Time</th>
                        <th scope="col">User</th>
                        <th scope="col">Action</th>
                        <th scope="col">Record</th>
                        <th scope="col">Details</th>
                        <th scope="col">IP address</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Logs.Items)
                    {
                        <tr>
                            <td class="text-nowrap small"><partial name="_LocalTime" model="l.TimestampUtc" /></td>
                            <td>@(l.UserName ?? "Anonymous")</td>
                            <td class="text-nowrap">@l.Action</td>
                            <td class="text-nowrap small">@l.EntityType@(string.IsNullOrEmpty(l.EntityId) ? "" : " #" + l.EntityId)</td>
                            <td class="small">@l.Details</td>
                            <td class="small text-nowrap">@l.IpAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted">
                @Model.Logs.TotalCount entr@(Model.Logs.TotalCount == 1 ? "y" : "ies") &middot; page @Model.Logs.Page of @Model.Logs.TotalPages
            </span>
            <partial name="_GenericPager" model="new GenericPagerInfo(Model.Logs.Page, Model.Logs.TotalPages, query)" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-journal" aria-hidden="true"></i>
            @(filtersActive ? "No entries match your filters." : "Nothing has been recorded yet.")
        </div>
    }
</div>

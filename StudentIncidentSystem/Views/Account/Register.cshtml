@model StudentIncidentSystem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Student registration";
}

<div class="auth-wrap">
    <div class="auth-card" style="max-width: 520px;">
        <div class="card">
            <div class="card-body p-4 p-md-5">
                <div class="auth-icon" aria-hidden="true"><i class="bi bi-person-plus"></i></div>
                <h1 class="h3 text-center mb-1">Create a student account</h1>
                <p class="text-muted text-center mb-4">Register to submit and track your reports.</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SchoolIdNumber" class="form-label"></label>
                        <input asp-for="SchoolIdNumber" class="form-control" />
                        <span asp-validation-for="SchoolIdNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter, and a number.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Register</button>
                </form>

                <p class="mt-4 mb-0 text-center text-muted">
                    Already registered? <a asp-action="Login" class="fw-semibold">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@inject StudentIncidentSystem.Services.SettingsService AppSettings
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;
    var roleName = User.IsInRole(AppRoles.Administrator) ? "Administrator"
                 : User.IsInRole(AppRoles.Staff) ? "Staff"
                 : User.IsInRole(AppRoles.Student) ? "Student" : "";
    var school = (await AppSettings.GetAsync()).SchoolName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @school</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg?v=2" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable position-absolute p-2 bg-white" href="#main">Skip to main content</a>

    @if (isAuthenticated)
    {
        <header class="mobile-topbar d-lg-none">
            <button class="btn btn-outline-light btn-sm" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#sidebar"
                    aria-controls="sidebar" aria-label="Open navigation menu">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <span class="fw-semibold">@school</span>
        </header>

        <div class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="sidebar" aria-label="Main navigation">
            <div class="offcanvas-header border-bottom border-light-subtle">
                <span class="sidebar-brand p-0"><i class="bi bi-shield-check me-2" aria-hidden="true"></i>@school</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"
                        data-bs-target="#sidebar" aria-label="Close navigation menu"></button>
            </div>
            <div class="offcanvas-body">
                <div class="sidebar-brand d-none d-lg-flex">
                    <i class="bi bi-shield-check me-2" aria-hidden="true"></i>@school
                </div>

                <nav aria-label="Primary">
                    <partial name="_Sidebar" />
                </nav>

                <div class="sidebar-user mt-auto">
                    <div class="fw-semibold text-truncate">@displayName</div>
                    <div class="small text-white-50 mb-2">@roleName</div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">
                            <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Log out
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <main class="main-content" id="main">
            <div class="container-fluid py-4 px-3 px-lg-4">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
            <footer class="px-3 px-lg-4 pb-3 small text-muted">
                <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                This system is not an emergency service. If you are in immediate danger, tell a
                teacher or school authority right away, or contact local emergency services.
            </footer>
        </main>
    }
    else
    {
        <nav class="navbar navbar-expand navbar-dark" style="background-color: var(--navy);">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-check me-2" aria-hidden="true"></i>@school
                </a>
                <div class="ms-auto">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
        <main class="container py-3" id="main">
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



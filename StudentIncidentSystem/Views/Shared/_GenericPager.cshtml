@model GenericPagerInfo
@{
    Func<int, Dictionary<string, string>> link = p =>
    {
        var d = new Dictionary<string, string>(Model.Query);
        d["page"] = p.ToString();
        return d;
    };
    var first = Math.Max(1, Model.Page - 3);
    var last = Math.Min(Model.TotalPages, Model.Page + 3);
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="link(Math.Max(1, Model.Page - 1))">Previous</a>
            </li>
            @for (var p = first; p <= last; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="link(p)"
                       aria-current="@(p == Model.Page ? "page" : null)">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="link(Math.Min(Model.TotalPages, Model.Page + 1))">Next</a>
            </li>
        </ul>
    </nav>
}

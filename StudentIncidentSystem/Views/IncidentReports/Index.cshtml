@model MyReportsViewModel
@{
    ViewData["Title"] = "My reports";
    var filtersActive = !string.IsNullOrWhiteSpace(Model.Search) || Model.StatusFilter.HasValue;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">My reports</h1>
        <p class="text-muted mb-0">Every report you have submitted.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Submit New Report
    </a>
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label for="q" class="form-label small mb-1">Search reference or title</label>
                <input id="q" name="q" value="@Model.Search" class="form-control" maxlength="100" placeholder="e.g. INC-2026" />
            </div>
            <div class="col-8 col-md-4">
                <label for="status" class="form-label small mb-1">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var s in Enum.GetValues<IncidentStatus>())
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@StatusDisplay.Label(s)</option>
                    }
                </select>
            </div>
            <div class="col-4 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (filtersActive)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Reports.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Title</th>
                        <th scope="col">Category</th>
                        <th scope="col">Status</th>
                        <th scope="col">Submitted</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reports.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@r.ReferenceNumber</td>
                            <td>@r.Title</td>
                            <td>@r.CategoryName</td>
                            <td><partial name="_StatusBadge" model="r.Status" /></td>
                            <td class="text-nowrap small"><partial name="_LocalTime" model="r.CreatedAtUtc" /></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-primary btn-sm">
                                    View<span class="visually-hidden"> @r.ReferenceNumber</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted">
                @Model.Reports.TotalCount report@(Model.Reports.TotalCount == 1 ? "" : "s") &middot; page @Model.Reports.Page of @Model.Reports.TotalPages
            </span>
            <partial name="_Pager" model="new PagerInfo(Model.Reports.Page, Model.Reports.TotalPages, Model.Search, Model.StatusFilter)" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            @if (filtersActive)
            {
                <span>No reports match your filters.</span>
            }
            else
            {
                <span>You have not submitted any reports yet.</span>
            }
        </div>
    }
</div>
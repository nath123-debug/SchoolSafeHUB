@model ReportsViewModel
@{
    ViewData["Title"] = "Reports";
    var f = Model.Filter;
    var fromText = f.From?.ToString("yyyy-MM-dd");
    var toText = f.To?.ToString("yyyy-MM-dd");
    var filtersActive = !string.IsNullOrWhiteSpace(f.Q) || f.Status.HasValue || f.CategoryId.HasValue
                        || f.From.HasValue || f.To.HasValue || !string.IsNullOrEmpty(f.AssignedTo);

    // The current filters, carried into the export, print, and pager links
    var query = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(f.Q)) query["q"] = f.Q.Trim();
    if (f.Status.HasValue) query["status"] = f.Status.Value.ToString();
    if (f.CategoryId.HasValue) query["categoryId"] = f.CategoryId.Value.ToString();
    if (fromText != null) query["from"] = fromText;
    if (toText != null) query["to"] = toText;
    if (!string.IsNullOrEmpty(f.AssignedTo)) query["assignedTo"] = f.AssignedTo;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">Reports</h1>
        <p class="text-muted mb-0">
            @(Model.IsAdmin
                ? "Statistics for all cases. Report contents and notes are not shown to administrators."
                : "Statistics for the cases in your scope: cases assigned to you and unassigned cases.")
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-all-route-data="query" class="btn btn-outline-primary">
            <i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV
        </a>
        <a asp-action="Print" asp-all-route-data="query" target="_blank" rel="noopener" class="btn btn-outline-primary">
            <i class="bi bi-printer me-1" aria-hidden="true"></i>Printable report
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="q" class="form-label small mb-1">Reference number</label>
                <input id="q" name="q" value="@f.Q" class="form-control" maxlength="100" placeholder="e.g. INC-2026" />
            </div>
            <div class="col-6 col-md-3">
                <label for="status" class="form-label small mb-1">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var s in Enum.GetValues<IncidentStatus>())
                    {
                        <option value="@s" selected="@(f.Status == s)">@StatusDisplay.Label(s)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="categoryId" class="form-label small mb-1">Category</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id" selected="@(f.CategoryId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label for="assignedTo" class="form-label small mb-1">Assigned to</label>
                <select id="assignedTo" name="assignedTo" class="form-select">
                    <option value="">Anyone</option>
                    <option value="unassigned" selected="@(f.AssignedTo == "unassigned")">Unassigned</option>
                    @foreach (var s in Model.AssignOptions)
                    {
                        <option value="@s.Id" selected="@(f.AssignedTo == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="from" class="form-label small mb-1">Submitted from</label>
                <input id="from" name="from" type="date" value="@fromText" class="form-control" />
            </div>
            <div class="col-6 col-md-3">
                <label for="to" class="form-label small mb-1">Submitted to</label>
                <input id="to" name="to" type="date" value="@toText" class="form-control" />
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Apply filters</button>
                @if (filtersActive)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <partial name="_StatCard" model='new StatCard("Matching cases", Model.Total, "bi-journal-text", "primary")' />
    </div>
    <div class="col-6 col-md-4">
        <partial name="_StatCard" model='new StatCard("Open", Model.OpenCount, "bi-folder2-open", "warning")' />
    </div>
    <div class="col-6 col-md-4">
        <partial name="_StatCard" model='new StatCard("Resolved or closed", Model.ResolvedCount, "bi-check-circle", "success")' />
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">By status</div>
            <table class="table table-sm align-middle mb-0">
                <tbody>
                    @foreach (var row in Model.ByStatus)
                    {
                        <tr><td>@row.Label</td><td class="text-end fw-semibold">@row.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">By category</div>
            @if (Model.ByCategory.Any())
            {
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @foreach (var row in Model.ByCategory)
                        {
                            var pct = Model.Total > 0 ? (int)Math.Round(100.0 * row.Count / Model.Total) : 0;
                            <tr>
                                <td>@row.Label</td>
                                <td class="text-end text-nowrap"><span class="fw-semibold">@row.Count</span> <span class="text-muted small">(@pct%)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state"><i class="bi bi-pie-chart" aria-hidden="true"></i>No cases match.</div>
            }
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Monthly incidents</div>
            @if (Model.ByMonth.Any())
            {
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @foreach (var row in Model.ByMonth)
                        {
                            <tr><td>@row.Label</td><td class="text-end fw-semibold">@row.Count</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state"><i class="bi bi-bar-chart" aria-hidden="true"></i>No cases match.</div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold">Cases</div>
    @if (Model.Rows.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Reference</th>
                        @if (!Model.IsAdmin) { <th scope="col">Title</th> }
                        <th scope="col">Category</th>
                        <th scope="col">Status</th>
                        <th scope="col">Assigned to</th>
                        <th scope="col">Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows.Items)
                    {
                        <tr>
                            <td class="text-nowrap">
                                @if (Model.IsAdmin)
                                {
                                    @r.ReferenceNumber
                                }
                                else
                                {
                                    <a asp-controller="StaffIncidents" asp-action="Details" asp-route-id="@r.Id">@r.ReferenceNumber</a>
                                }
                            </td>
                            @if (!Model.IsAdmin) { <td>@r.Title</td> }
                            <td>@r.CategoryName</td>
                            <td><partial name="_StatusBadge" model="r.Status" /></td>
                            <td>@(r.AssignedToName ?? "Unassigned")</td>
                            <td class="text-nowrap small"><partial name="_LocalTime" model="r.CreatedAtUtc" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted">
                @Model.Rows.TotalCount case@(Model.Rows.TotalCount == 1 ? "" : "s") &middot; page @Model.Rows.Page of @Model.Rows.TotalPages
            </span>
            <partial name="_GenericPager" model="new GenericPagerInfo(Model.Rows.Page, Model.Rows.TotalPages, query)" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-search" aria-hidden="true"></i>
            @(filtersActive ? "No cases match your filters." : "There are no cases yet.")
        </div>
    }
</div>

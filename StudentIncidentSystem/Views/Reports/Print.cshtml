@model ReportsViewModel
@{
    Layout = null;
    var f = Model.Filter;
    var who = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;

    var applied = new List<string>();
    if (!string.IsNullOrWhiteSpace(f.Q)) applied.Add("Reference contains \"" + f.Q.Trim() + "\"");
    if (f.Status.HasValue) applied.Add("Status: " + StatusDisplay.Label(f.Status.Value));
    if (f.CategoryId.HasValue) applied.Add("Category: " + (Model.Categories.FirstOrDefault(c => c.Id == f.CategoryId)?.Name ?? "Unknown"));
    if (f.From.HasValue) applied.Add("From " + f.From.Value.ToString("yyyy-MM-dd"));
    if (f.To.HasValue) applied.Add("To " + f.To.Value.ToString("yyyy-MM-dd"));
    if (f.AssignedTo == "unassigned") applied.Add("Unassigned only");
    else if (!string.IsNullOrEmpty(f.AssignedTo)) applied.Add("Assigned to: " + (Model.AssignOptions.FirstOrDefault(o => o.Id == f.AssignedTo)?.Name ?? "Unknown"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Incident report summary</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #fff; color: #000; }
        .table { font-size: 0.85rem; }
    </style>
</head>
<body>
    <div class="container py-4">
        <div class="d-print-none mb-3 d-flex gap-2">
            <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
            <button type="button" class="btn btn-outline-secondary" onclick="window.close()">Close</button>
        </div>

        <h1 class="h3 mb-1">Incident report summary</h1>
        <p class="text-muted mb-1">
            Generated @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC by @who
        </p>
        <p class="mb-3">
            <strong>Filters:</strong> @(applied.Any() ? string.Join("; ", applied) : "none (all cases in your scope)")
        </p>

        <div class="row g-3 mb-4">
            <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0">@Model.Total</div><div class="small text-muted">Matching cases</div></div></div>
            <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0">@Model.OpenCount</div><div class="small text-muted">Open</div></div></div>
            <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0">@Model.ResolvedCount</div><div class="small text-muted">Resolved or closed</div></div></div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-4">
                <h2 class="h6">By status</h2>
                <table class="table table-sm">
                    <tbody>
                        @foreach (var row in Model.ByStatus) { <tr><td>@row.Label</td><td class="text-end">@row.Count</td></tr> }
                    </tbody>
                </table>
            </div>
            <div class="col-4">
                <h2 class="h6">By category</h2>
                <table class="table table-sm">
                    <tbody>
                        @foreach (var row in Model.ByCategory) { <tr><td>@row.Label</td><td class="text-end">@row.Count</td></tr> }
                    </tbody>
                </table>
            </div>
            <div class="col-4">
                <h2 class="h6">Monthly incidents</h2>
                <table class="table table-sm">
                    <tbody>
                        @foreach (var row in Model.ByMonth) { <tr><td>@row.Label</td><td class="text-end">@row.Count</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <h2 class="h6">Cases</h2>
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>Reference</th>
                    @if (!Model.IsAdmin) { <th>Title</th> }
                    <th>Category</th>
                    <th>Status</th>
                    <th>Assigned to</th>
                    <th>Submitted (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows.Items)
                {
                    <tr>
                        <td>@r.ReferenceNumber</td>
                        @if (!Model.IsAdmin) { <td>@r.Title</td> }
                        <td>@r.CategoryName</td>
                        <td>@StatusDisplay.Label(r.Status)</td>
                        <td>@(r.AssignedToName ?? "Unassigned")</td>
                        <td>@r.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Total > Model.Rows.Items.Count)
        {
            <p class="small text-muted">Showing the first @Model.Rows.Items.Count of @Model.Total cases. Use the CSV export for the full list.</p>
        }

        <p class="small text-muted mt-4">
            Confidential. For authorized school use only. A report records one person's account and does not decide that anyone is guilty.
        </p>
    </div>
</body>
</html>

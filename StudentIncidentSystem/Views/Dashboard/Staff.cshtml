@model StaffDashboardViewModel
@{
    ViewData["Title"] = "Staff dashboard";
    var filtersActive = !string.IsNullOrWhiteSpace(Model.Search) || Model.StatusFilter.HasValue || Model.CategoryFilter.HasValue;
}

<div class="mb-4">
    <h1 class="h3 mb-0">Staff dashboard</h1>
    <p class="text-muted mb-0">Cases assigned to you and cases waiting to be assigned.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <partial name="_StatCard" model='new StatCard("Newly submitted", Model.Submitted, "bi-envelope-open", "primary")' />
    </div>
    <div class="col-6 col-xl-3">
        <partial name="_StatCard" model='new StatCard("Under review", Model.UnderReview, "bi-hourglass-split", "info")' />
    </div>
    <div class="col-6 col-xl-3">
        <partial name="_StatCard" model='new StatCard("Awaiting information", Model.AwaitingInformation, "bi-question-circle", "warning")' />
    </div>
    <div class="col-6 col-xl-3">
        <partial name="_StatCard" model='new StatCard("Resolved", Model.Resolved, "bi-check-circle", "success")' />
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Cases by category</div>
            <div class="card-body">
                @if (Model.CategoryChart.HasData)
                {
                    <div class="chart-box"><canvas id="categoryChart" role="img" aria-label="Doughnut chart of cases by category"></canvas></div>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-pie-chart" aria-hidden="true"></i>No cases to chart yet.</div>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Recent activity</div>
            @if (Model.RecentActivity.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var a in Model.RecentActivity)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between flex-wrap gap-1">
                                <span><span class="fw-semibold">@a.ReferenceNumber</span> &middot; @a.ChangedByName</span>
                                <span class="small text-muted"><partial name="_LocalTime" model="a.ChangedAtUtc" /></span>
                            </div>
                            <div class="mt-1">
                                @if (a.OldStatus.HasValue)
                                {
                                    <partial name="_StatusBadge" model="a.OldStatus.Value" />
                                    <i class="bi bi-arrow-right mx-1" aria-label="changed to"></i>
                                }
                                <partial name="_StatusBadge" model="a.NewStatus" />
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state"><i class="bi bi-activity" aria-hidden="true"></i>No activity yet.</div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold">Cases</div>
    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="q" class="form-label small mb-1">Search reference or title</label>
                <input id="q" name="q" value="@Model.Search" class="form-control" maxlength="100" placeholder="e.g. INC-2026" />
            </div>
            <div class="col-6 col-md-3">
                <label for="status" class="form-label small mb-1">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var s in Enum.GetValues<IncidentStatus>())
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@StatusDisplay.Label(s)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="categoryId" class="form-label small mb-1">Category</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id" selected="@(Model.CategoryFilter == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (filtersActive)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Cases.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Title</th>
                        <th scope="col">Category</th>
                        <th scope="col">Status</th>
                        <th scope="col">Assigned to</th>
                        <th scope="col">Last updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Cases)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-controller="StaffIncidents" asp-action="Details" asp-route-id="@c.Id">@c.ReferenceNumber</a></td>
                            <td>@c.Title</td>
                            <td>@c.CategoryName</td>
                            <td><partial name="_StatusBadge" model="c.Status" /></td>
                            <td>@(c.AssignedToName ?? "Unassigned")</td>
                            <td class="text-nowrap small"><partial name="_LocalTime" model="c.UpdatedAtUtc" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white small text-muted">
            Showing @Model.Cases.Count of @Model.TotalMatching matching cases. Open Case management for the full list.
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-search" aria-hidden="true"></i>
            @(filtersActive ? "No cases match your filters." : "There are no cases in your scope yet.")
        </div>
    }
</div>

@section Scripts {
    @if (Model.CategoryChart.HasData)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
        <script>
            renderChart('categoryChart', 'doughnut',
                @Json.Serialize(Model.CategoryChart.Labels),
                @Json.Serialize(Model.CategoryChart.Values),
                'Cases');
        </script>
    }
}



@model StaffIndexViewModel
@{
    ViewData["Title"] = "Case management";
    var filtersActive = !string.IsNullOrWhiteSpace(Model.Search) || Model.StatusFilter.HasValue
                        || Model.CategoryFilter.HasValue || Model.Scope != "all";
}

<div class="mb-4">
    <h1 class="h3 mb-0">Case management</h1>
    <p class="text-muted mb-0">Cases assigned to you and cases waiting to be assigned.</p>
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="q" class="form-label small mb-1">Search reference or title</label>
                <input id="q" name="q" value="@Model.Search" class="form-control" maxlength="100" placeholder="e.g. INC-2026" />
            </div>
            <div class="col-6 col-md-2">
                <label for="scope" class="form-label small mb-1">Show</label>
                <select id="scope" name="scope" class="form-select">
                    <option value="all" selected="@(Model.Scope == "all")">All my cases</option>
                    <option value="mine" selected="@(Model.Scope == "mine")">Assigned to me</option>
                    <option value="unassigned" selected="@(Model.Scope == "unassigned")">Unassigned</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="status" class="form-label small mb-1">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var s in Enum.GetValues<IncidentStatus>())
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@StatusDisplay.Label(s)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="categoryId" class="form-label small mb-1">Category</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id" selected="@(Model.CategoryFilter == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (filtersActive)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Cases.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Title</th>
                        <th scope="col">Category</th>
                        <th scope="col">Status</th>
                        <th scope="col">Assigned to</th>
                        <th scope="col">Last updated</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Cases.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@c.ReferenceNumber</td>
                            <td>@c.Title</td>
                            <td>@c.CategoryName</td>
                            <td><partial name="_StatusBadge" model="c.Status" /></td>
                            <td>@(c.AssignedToName ?? "Unassigned")</td>
                            <td class="text-nowrap small"><partial name="_LocalTime" model="c.UpdatedAtUtc" /></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">
                                    Open<span class="visually-hidden"> @c.ReferenceNumber</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted">
                @Model.Cases.TotalCount case@(Model.Cases.TotalCount == 1 ? "" : "s") &middot; page @Model.Cases.Page of @Model.Cases.TotalPages
            </span>
            <partial name="_StaffPager" model="new StaffPagerInfo(Model.Cases.Page, Model.Cases.TotalPages, Model.Search, Model.StatusFilter, Model.CategoryFilter, Model.Scope)" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            @(filtersActive ? "No cases match your filters." : "There are no cases in your scope yet.")
        </div>
    }
</div>
